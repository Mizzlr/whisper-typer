#!/usr/bin/env bash
set -euo pipefail

# Right-drag selection for Flameshot.
#
# Flameshot only accepts a selection with logical button 1 and this mouse's left
# button is mechanically unreliable, so the selection uses a physical right
# drag. `logi-mouse-daemon` owns the buttons and swaps logical left and right for
# the duration of the overlay, so no X button map is touched here: a crashed or
# killed capture cannot leave the buttons inverted, and the daemon expires the
# swap on its own if this script never sends `swap-off`.

runtime_dir="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
socket_path="${LOGI_MOUSE_SOCKET:-$runtime_dir/logi-mouse.sock}"
daemon_bin="${LOGI_MOUSE_DAEMON:-$HOME/.local/bin/logi-mouse-daemon}"
flameshot_bin="${FLAMESHOT_BIN:-/usr/bin/flameshot}"
capture_timeout="${FLAMESHOT_TIMEOUT:-300}"

exec 9>"$runtime_dir/flameshot-right-drag.lock"
if ! flock -n 9; then
  notify-send "Flameshot" "A capture is already in progress" 2>/dev/null || true
  exit 0
fi

control() {
  "$daemon_bin" --control "$1" --socket-path "$socket_path" >/dev/null 2>&1 || true
}

# Put the buttons back even when Flameshot exits abnormally, and close the lock
# fd for the child so an orphaned capture cannot hold it.
swap_off() { control swap-off; }
trap swap_off EXIT HUP INT QUIT TERM

control swap-on
timeout "$capture_timeout" "$flameshot_bin" gui -c -s 9>&- || true

[Unit]
Description=Voice Journal — Continuous background transcription TUI
After=graphical-session.target whisper-typer-rs.service
Wants=whisper-typer-rs.service
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/voice-journal --headless
WorkingDirectory=__REPO_DIR__
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
NoNewPrivileges=true
PrivateTmp=true

# Environment for audio + ONNX CUDA (Silero VAD uses ort)
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/%U/bus
Environment=LD_LIBRARY_PATH=__REPO_DIR__/target/release:__REPO_DIR__/.venv/lib/python3.12/site-packages/nvidia/cudnn/lib:/usr/local/lib/ollama/mlx_cuda_v13
Environment=TERM=xterm-256color

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=graphical-session.target
